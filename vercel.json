{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "logo-world",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "view",
          "value": "fancy"
        }
      ],
      "destination": "/animated/",
      "permanent": false
    },
    {
      "source": "/simple/",
      "destination": "/",
      "permanent": false
    }
  ]
}
